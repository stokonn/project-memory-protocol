{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-memory-protocol.invalid/1.0/state.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "enum": [
        "planning",
        "approved",
        "implementing",
        "verifying",
        "ready_for_release",
        "released"
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "interrupted",
        "blocked"
      ]
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "in_progress": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_authorization": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "scope_ref",
    "phase",
    "status",
    "completed",
    "in_progress",
    "blockers",
    "next_actions",
    "release_authorization"
  ],
  "additionalProperties": false
}
